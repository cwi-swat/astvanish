
var update;

function main(ql) {
    var env = {};
    initialize(ql, env);
    render(ql, env);
    update = compute(ql, env);
}

function initialize(ql, env) {
    with (form _ { _ } : ql) 
        for (const q of $2) 
            initializeQuestion(q, env);
}

function defaultFor(type) {
    match (type) {
        case int: return 0;
        case bool: return false;
        case str: return '';
    }
}

function initializeQuestion(q, env) {
    match (q) {
        case _ _ \: _ :
            env[$2.toString()] = defaultFor($3);

        case _ _ \: _ = _ :
            env[$2.toString()] = defaultFor($3);

        case { _ } :
            for (const q of $1) {
                initializeQuestion(q, env);
            }

        case if ( _ ) _ else _ : 
            initializeQuestion($2, env);
            initializeQuestion($3, env);

        case if ( _ ) _ _: 
            initializeQuestion($2, env);
    }
}

function render(ql, env) {
    with (form _ { _ } : ql) 
        for (const q of $2) 
            renderQuestion(q, env);
}

function compute(ql, env) {
    with (form _ { _ } : ql) {
        return function (x, val) {
            env[x] = val;
            var change = false;
            do {
                for (const q of $2) 
                    computeQuestion(q, env);
            }
            while (change);
        };
    }
}

function computeQuestion(q, env) {
    match (q) {
        case _ _ \: _ :
            /* nop */

        case _ _ \: _ = _ :
            var val = eval($4, env);
            if (val !== env[$2.toString()]) {
                change = true;
            }

        case { _ } :
            for (const q of $1) {
                computeQuestion(q, env);
            }

        case if ( _ ) _ else _ : 
            if (eval($1, env)) {
                computeQuestion($2, env);
            }
            else {
                computeQuestion($3, env);
            }

        case if ( _ ) _ _: 
            if (eval($1, env)) {
                computeQuestion($2, env);
            }   
    }
}


function renderQuestion(q, env) {
    match (q) {
        case _ _ \: _ :
            widget($3, $1.toString(), $2.toString(), false, env, function (x) { update($2.toString(), x.value); });

        case _ _ \: _ = _ :
            widget($3, $1.toString(), $2.toString(), true, env, null);

        case { _ } :
            for (const q of $1) {
                renderQuestion(q, env);
            }

        case if ( _ ) _ else _ : 
            if (eval($1, env)) {
                renderQuestion($2, env);
            }
            else {
                renderQuestion($3, env);
            }

        case if ( _ ) _ _:  // the last _ is the () empty for the follow restriction
            if (eval($1, env)) {
                renderQuestion($2, env);
            }
        
    }
}

function widget(type, label, name, readOnly, env, func) {
    page.append(label);
    var elt = createElement("input");            
    match (type) {
        case int : 
            elt.setAttribute("type", "number");
            elt.value = env[name];
        case bool :
            elt.setAttribute("type", "checkbox");
            elt.checked = env[name];
        case str :
            elt.setAttribute("type", "text");
            elt.value = env[name];
    }
    page.append(elt);
    if (readOnly) {
        elt.disabled = true;
    }
    else {
        elt.onchange = func;
    }
}

function eval(e, env) {
    match (e) {
        case _@Id : return env[$1.toString()];
        case _@Int : return parseInt($1.toString());
        case _@Str : return unquote($1.toString());
        case _@Bool : return $1.toString() === 'true';
        case ( _ ) : return eval($1, env);
        case ! _ : return !eval($1, env);
        case _ * _: return eval($1, env) * eval($2, env);
        case _ / _: return Math.round(eval($1, env) / eval($2, env));
        case _ + _: return eval($1, env) + eval($2, env);
        case _ - _: return eval($1, env) - eval($2, env);
        case _ == _: return eval($1, env) === eval($2, env);
        case _ != _: return eval($1, env) !== eval($2, env);
        case _ > _: return eval($1, env) > eval($2, env);
        case _ < _: return eval($1, env) < eval($2, env);
        case _ <= _: return eval($1, env) <= eval($2, env);
        case _ >= _: return eval($1, env) >= eval($2, env);
        case _ && _: return eval($1, env) && eval($2, env);
        case _ || _: return eval($1, env) || eval($2, env);
    }
}

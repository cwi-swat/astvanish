
export { run as run };


function run($ql) {
    var env = {};
    initialize($ql, env);

    var update = compute($ql, env);
    render($ql, env, update);
    var vis = true;
    with (form _ { _ }: $ql) {
        for (const q of $2) {
            updateVisibility(q, vis, env);
        }
    }
}


function initialize($ql, env) {
    with (form _ { _ } : $ql) 
        for (const q of $2) 
            initializeQuestion(q, env);
}

function defaultFor($type) {
    match ($type) {
        case int: return 0;
        case bool: return false;
        case str: return '';
    }
}

function initializeQuestion($q, env) {
    match ($q) {
        case _ _ \: _ :
            env[$2.toString()] = defaultFor($3);

        case _ _ \: _ = _ :
            env[$2.toString()] = defaultFor($3);

        case { _ } :
            for (const q of $1) {
                initializeQuestion(q, env);
            }

        case if ( _ ) _ else _ : 
            initializeQuestion($2, env);
            initializeQuestion($3, env);

        case if ( _ ) _ _: 
            initializeQuestion($2, env);
    }
}

function render($ql, env, upd) {
    with (form _ { _ } : $ql) 
        for (const q of $2) 
            renderQuestion(q, env, upd);
}

function renderQuestion($q, env, upd) {
    match ($q) {
        case _ _ \: _ :
            widget($3, $1, $2, false, env, function (x) { 
                match ($3) {
                    case int: upd($2.toString(), x.target.value); 
                    case bool: upd($2.toString(), x.target.checked); 
                    case str: upd($2.toString(), x.target.value); 
                }
            });

        case _ _ \: _ = _ :
            widget($3, $1, $2, true, env, null);

        case { _ } :
            for (const q of $1) {
                renderQuestion(q, env, upd);
            }

        case if ( _ ) _ else _ : 
            renderQuestion($2, env, upd);
            renderQuestion($3, env, upd);

        case if ( _ ) _ _:  // the last _ is the () empty for the follow restriction
            renderQuestion($2, env, upd);
    }
}

function widget($type, $label, $name, readOnly, env, func) {
    var div = document.createElement('div');
    div.id = $name.toString() + '-div';
    div.appendChild(document.createTextNode($label.toString().slice(1, -1)));
    var elt = document.createElement('input'); 
    elt.id = $name.toString() + '-widget';           
    match ($type) {
        case int : 
            elt.setAttribute('type', 'number');
            elt.value = env[$name.toString()];
        case bool :
            elt.setAttribute('type', 'checkbox');
            elt.checked = env[$name.toString()];
        case str :
            elt.setAttribute('type', 'text');
            elt.value = env[$name.toString()];
    }
    if (readOnly) {
        elt.disabled = true;
    }
    else {
        elt.onchange = func;
    }
    div.appendChild(elt);
    document.body.appendChild(div);
}


function compute($ql, env) {
    with (form _ { _ } : $ql) {
        return function (x, val) {
            env[x] = val;
            do {
                var change = false;
            
                for (const q of $2) 
                    change = change || computeQuestion(q, env);
            }
            while (change);
            var vis = true;
            for (const q of $2) {
                updateVisibility(q, vis, env);
            }
        };
    }
}

function updateVisibility($q, vis, env) {
    match ($q) {
        case _ _ \: _ :
            var elt = document.getElementById($2.toString() + '-div');
            elt.style.display = vis ? 'block' : 'none';

        case _ _ \: _ = _ :
            var elt = document.getElementById($2.toString() + '-div');
            elt.style.display = vis ? 'block' : 'none';
            
        case { _ } :
            for (const q of $1) {
                updateVisibility(q, vis, env);
            }

        case if ( _ ) _ else _ : 
            updateVisibility($2, eve($1, env), env);
            updateVisibility($3, !eve($1, env), env);

        case if ( _ ) _ _: 
            updateVisibility($2, eve($1, env), env);   
    }
}

function updateValue($name, $type, val) {
    var elt = document.getElementById($name.toString() + '-widget');
    match ($type) {
        case int: elt.value = val;
        case str: elt.value = val;
        case bool: elt.checked = val;
    }
}

function computeQuestion($q, env) {
    match ($q) {
        case _ _ \: _ :
            return false;

        case _ _ \: _ = _ :
            var val = eve($4, env);
            if (val !== env[$2.toString()]) {
                env[$2.toString()] = val;
                updateValue($2, $3, val);
                return true;
            }

        case { _ } :
            var change = false;
            for (const q of $1) {
                change = change || computeQuestion(q, env);
            }
            return change;

        case if ( _ ) _ else _ : 
            if (eve($1, env)) {
                return computeQuestion($2, env);
            }
            else {
                return computeQuestion($3, env);
            }

        case if ( _ ) _ _: 
            if (eve($1, env)) {
                return computeQuestion($2, env);
            }   
    }
}



function eve($e, env) {
    match ($e) {
        case _@Id : return env[$1.toString()];
        case _@Int : return parseInt($1.toString());
        case _@Str : return unquote($1.toString());
        case _@Bool : return $1.toString() === 'true';
        case ( _ ) : return eve($1, env);
        case ! _ : return !eve($1, env);
        case _ * _: return eve($1, env) * eve($2, env);
        case _ / _: return Math.round(eve($1, env) / eve($2, env));
        case _ + _: return eve($1, env) + eve($2, env);
        case _ - _: return eve($1, env) - eve($2, env);
        case _ == _: return eve($1, env) === eve($2, env);
        case _ != _: return eve($1, env) !== eve($2, env);
        case _ > _: return eve($1, env) > eve($2, env);
        case _ < _: return eve($1, env) < eve($2, env);
        case _ <= _: return eve($1, env) <= eve($2, env);
        case _ >= _: return eve($1, env) >= eve($2, env);
        case _ && _: return eve($1, env) && eve($2, env);
        case _ || _: return eve($1, env) || eve($2, env);
    }
}

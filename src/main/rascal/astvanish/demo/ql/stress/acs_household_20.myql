// Generated by gen_acs.py: American Community Survey household form, 20 person(s).
// Source: U.S. Census Bureau ACS-1 questionnaire (public domain); question
// numbers follow the ACS. Real households have up to about 20 persons;
// larger forms keep the same structure for scale tests.
form "American Community Survey, household of 20" {
  "Number of persons living or staying at this address:"
    nPersons: integer

  // ---------------------------------------------------------------- Housing
  "H1. Which best describes this building (house, apartment, mobile home, ...)?"
    hBuildingType: string
  "H2. About when was this building first built (year)?"
    hYearBuilt: integer
  "H3. When did you move into this house or apartment (year)?"
    hMoveIn: integer
  "H4. Is this house on 1 acre or more?"
    hAcre: boolean
  if (hAcre) {
    "H5. Agricultural sales in the last 12 months (USD):"
      hAgSales: integer
  }
  "H6. Number of bedrooms:"
    hBedrooms: integer
  "H7. Number of rooms (excluding bathrooms):"
    hRooms: integer
  "H8. Has hot and cold running water?"
    hWater: boolean
  "H8. Has a bathtub or shower?"
    hShower: boolean
  "H8. Has a refrigerator?"
    hFridge: boolean
  "H8. Has a stove or range?"
    hStove: boolean
  "H9. Has a broadband internet subscription?"
    hBroadband: boolean
  "H10. Number of automobiles, vans and trucks kept at home:"
    hVehicles: integer
  "H11. Monthly electricity cost (USD):"
    hElectricity: integer
  "H11. Monthly gas cost (USD):"
    hGas: integer
  "H11. Yearly water and sewer cost (USD):"
    hWaterCost: integer
  "H12. Is this house owned (with or without a mortgage)?"
    hOwned: boolean
  if (hOwned) {
    "H13. Is there a mortgage on this property?"
      hMortgage: boolean
    if (hMortgage) {
      "H14. Monthly mortgage payment (USD):"
        hMortgagePayment: integer
      "H15. Does the payment include real estate taxes?"
        hMortgageTaxes: boolean
    }
    "H16. Yearly real estate taxes (USD):"
      hRealEstateTaxes: integer
    "H17. Yearly fire, hazard and flood insurance (USD):"
      hInsurance: integer
    "H18. Value of the property (USD):"
      hValue: integer
  } else {
    "H19. Monthly rent (USD):"
      hRent: integer
    "H20. Does the rent include meals?"
      hRentMeals: boolean
  }
  "Monthly housing cost (USD):"
    hMonthlyCost: integer = hMortgagePayment + hRent + hElectricity + hGas + hWaterCost / 12 + hRealEstateTaxes / 12 + hInsurance / 12
  "Crowded (more than one person per room):"
    hCrowded: boolean = nPersons > hRooms

  // ---------------------------------------------------------------- Person 1
  "P1 1. Name of person 1:"
    p1Name: string
  "P1 3. Is this person female?"
    p1Female: boolean
  "P1 4. Age (years):"
    p1Age: integer
  "P1 5. Is this person of Hispanic, Latino or Spanish origin?"
    p1Hispanic: boolean
  if (p1Hispanic) {
    "P1 5. Origin (Mexican, Puerto Rican, Cuban, ...):"
      p1HispanicOrigin: string
  }
  "P1 6. Race:"
    p1Race: string
  "P1 7. Born in the United States?"
    p1BornUS: boolean
  if (!p1BornUS) {
    "P1 7. Country of birth:"
      p1BirthCountry: string
    "P1 8. U.S. citizen by naturalization?"
      p1Naturalized: boolean
    "P1 9. Year this person came to live in the U.S.:"
      p1YearArrived: integer
  }
  if (p1Age >= 3) {
    "P1 10. Attended school or college in the last 3 months?"
      p1InSchool: boolean
    if (p1InSchool) {
      "P1 10. Grade or level attending:"
        p1SchoolGrade: string
    }
  }
  if (p1Age >= 5) {
    "P1 12. Speaks a language other than English at home?"
      p1OtherLanguage: boolean
    if (p1OtherLanguage) {
      "P1 12. Which language?"
        p1Language: string
      "P1 12. Speaks English very well?"
        p1EnglishWell: boolean
    }
  }
  "P1 15. Lived in this house one year ago?"
    p1SameHouse: boolean
  "P1 16. Covered by health insurance through an employer?"
    p1InsEmployer: boolean
  "P1 16. Covered by Medicare?"
    p1InsMedicare: boolean
  "P1 16. Covered by Medicaid or other government assistance plan?"
    p1InsMedicaid: boolean
  "P1 Uninsured:"
    p1Uninsured: boolean = !p1InsEmployer && !p1InsMedicare && !p1InsMedicaid
  "P1 17. Difficulty concentrating, remembering or making decisions?"
    p1DifficultyCognitive: boolean
  "P1 18. Difficulty walking or climbing stairs?"
    p1DifficultyWalking: boolean
  if (p1Age >= 15) {
    "P1 20. Currently married?"
      p1Married: boolean
    "P1 21. Highest degree or level of school completed:"
      p1Education: string
  }
  if (p1Age >= 16) {
    "P1 30. Worked for pay last week?"
      p1WorkedLastWeek: boolean
    if (p1WorkedLastWeek) {
      "P1 31. Address of main place of work:"
        p1WorkAddress: string
      "P1 33. Minutes to get from home to work:"
        p1CommuteMinutes: integer
      "P1 33. Long commute (60 minutes or more):"
        p1LongCommute: boolean = p1CommuteMinutes >= 60
      "P1 41. Usual hours worked per week:"
        p1Hours: integer
      "P1 41. Works full time:"
        p1FullTime: boolean = p1Hours >= 35
      "P1 44. Self-employed in own business?"
        p1SelfEmployed: boolean
      "P1 46. Kind of work (occupation):"
        p1Occupation: string
    } else {
      "P1 36. Looking for work in the last 4 weeks?"
        p1LookingForWork: boolean
    }
  }
  if (p1Age >= 15) {
    "P1 47a. Wages, salary, commissions, bonuses or tips (USD):"
      p1Wages: integer
    "P1 47b. Self-employment income (USD):"
      p1SelfEmpIncome: integer
    "P1 47c. Interest, dividends, net rental income (USD):"
      p1Interest: integer
    "P1 47d. Social Security or Railroad Retirement (USD):"
      p1SocialSecurity: integer
    "P1 47e. Supplemental Security Income (USD):"
      p1Ssi: integer
    "P1 47f. Public assistance or welfare (USD):"
      p1Welfare: integer
    "P1 47g. Retirement, survivor or disability pensions (USD):"
      p1Pension: integer
    "P1 47h. Any other regular income (USD):"
      p1OtherIncome: integer
  }
  "P1 48. Total income in the past 12 months (USD):"
    p1Income: integer = p1Wages + p1SelfEmpIncome + p1Interest + p1SocialSecurity + p1Ssi + p1Welfare + p1Pension + p1OtherIncome
  "P1 Receives public assistance:"
    p1OnAssistance: boolean = p1Ssi > 0 || p1Welfare > 0
  "P1 Household income so far (USD):"
    p1HhIncome: integer = p1Income
  "P1 Workers in the household so far:"
    p1HhWorkers: integer = (p1Hours + 98) / 99


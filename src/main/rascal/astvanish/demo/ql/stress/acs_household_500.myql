      p499Education: string
  }
  if (p499Age >= 16) {
    "P499 30. Worked for pay last week?"
      p499WorkedLastWeek: boolean
    if (p499WorkedLastWeek) {
      "P499 31. Address of main place of work:"
        p499WorkAddress: string
      "P499 33. Minutes to get from home to work:"
        p499CommuteMinutes: integer
      "P499 33. Long commute (60 minutes or more):"
        p499LongCommute: boolean = p499CommuteMinutes >= 60
      "P499 41. Usual hours worked per week:"
        p499Hours: integer
      "P499 41. Works full time:"
        p499FullTime: boolean = p499Hours >= 35
      "P499 44. Self-employed in own business?"
        p499SelfEmployed: boolean
      "P499 46. Kind of work (occupation):"
        p499Occupation: string
    } else {
      "P499 36. Looking for work in the last 4 weeks?"
        p499LookingForWork: boolean
    }
  }
  if (p499Age >= 15) {
    "P499 47a. Wages, salary, commissions, bonuses or tips (USD):"
      p499Wages: integer
    "P499 47b. Self-employment income (USD):"
      p499SelfEmpIncome: integer
    "P499 47c. Interest, dividends, net rental income (USD):"
      p499Interest: integer
    "P499 47d. Social Security or Railroad Retirement (USD):"
      p499SocialSecurity: integer
    "P499 47e. Supplemental Security Income (USD):"
      p499Ssi: integer
    "P499 47f. Public assistance or welfare (USD):"
      p499Welfare: integer
    "P499 47g. Retirement, survivor or disability pensions (USD):"
      p499Pension: integer
    "P499 47h. Any other regular income (USD):"
      p499OtherIncome: integer
  }
  "P499 48. Total income in the past 12 months (USD):"
    p499Income: integer = p499Wages + p499SelfEmpIncome + p499Interest + p499SocialSecurity + p499Ssi + p499Welfare + p499Pension + p499OtherIncome
  "P499 Receives public assistance:"
    p499OnAssistance: boolean = p499Ssi > 0 || p499Welfare > 0
  "P499 Household income so far (USD):"
    p499HhIncome: integer = p498HhIncome + p499Income
  "P499 Workers in the household so far:"
    p499HhWorkers: integer = p498HhWorkers + (p499Hours + 98) / 99

  // ---------------------------------------------------------------- Person 500
  "P500 1. Name of person 500:"
    p500Name: string
  "P500 2. How is this person related to Person 1 (spouse, child, parent, roommate, ...)?"
    p500Relationship: string
  "P500 3. Is this person female?"
    p500Female: boolean
  "P500 4. Age (years):"
    p500Age: integer
  "P500 5. Is this person of Hispanic, Latino or Spanish origin?"
    p500Hispanic: boolean
  if (p500Hispanic) {
    "P500 5. Origin (Mexican, Puerto Rican, Cuban, ...):"
      p500HispanicOrigin: string
  }
  "P500 6. Race:"
    p500Race: string
  "P500 7. Born in the United States?"
    p500BornUS: boolean
  if (!p500BornUS) {
    "P500 7. Country of birth:"
      p500BirthCountry: string
    "P500 8. U.S. citizen by naturalization?"
      p500Naturalized: boolean
    "P500 9. Year this person came to live in the U.S.:"
      p500YearArrived: integer
  }
  if (p500Age >= 3) {
    "P500 10. Attended school or college in the last 3 months?"
      p500InSchool: boolean
    if (p500InSchool) {
      "P500 10. Grade or level attending:"
        p500SchoolGrade: string
    }
  }
  if (p500Age >= 5) {
    "P500 12. Speaks a language other than English at home?"
      p500OtherLanguage: boolean
    if (p500OtherLanguage) {
      "P500 12. Which language?"
        p500Language: string
      "P500 12. Speaks English very well?"
        p500EnglishWell: boolean
    }
  }
  "P500 15. Lived in this house one year ago?"
    p500SameHouse: boolean
  "P500 16. Covered by health insurance through an employer?"
    p500InsEmployer: boolean
  "P500 16. Covered by Medicare?"
    p500InsMedicare: boolean
  "P500 16. Covered by Medicaid or other government assistance plan?"
    p500InsMedicaid: boolean
  "P500 Uninsured:"
    p500Uninsured: boolean = !p500InsEmployer && !p500InsMedicare && !p500InsMedicaid
  "P500 17. Difficulty concentrating, remembering or making decisions?"
    p500DifficultyCognitive: boolean
  "P500 18. Difficulty walking or climbing stairs?"
    p500DifficultyWalking: boolean
  if (p500Age >= 15) {
    "P500 20. Currently married?"
      p500Married: boolean
    "P500 21. Highest degree or level of school completed:"
      p500Education: string
  }
  if (p500Age >= 16) {
    "P500 30. Worked for pay last week?"
      p500WorkedLastWeek: boolean
    if (p500WorkedLastWeek) {
      "P500 31. Address of main place of work:"
        p500WorkAddress: string
      "P500 33. Minutes to get from home to work:"
        p500CommuteMinutes: integer
      "P500 33. Long commute (60 minutes or more):"
        p500LongCommute: boolean = p500CommuteMinutes >= 60
      "P500 41. Usual hours worked per week:"
        p500Hours: integer
      "P500 41. Works full time:"
        p500FullTime: boolean = p500Hours >= 35
      "P500 44. Self-employed in own business?"
        p500SelfEmployed: boolean
      "P500 46. Kind of work (occupation):"
        p500Occupation: string
    } else {
      "P500 36. Looking for work in the last 4 weeks?"
        p500LookingForWork: boolean
    }
  }
  if (p500Age >= 15) {
    "P500 47a. Wages, salary, commissions, bonuses or tips (USD):"
      p500Wages: integer
    "P500 47b. Self-employment income (USD):"
      p500SelfEmpIncome: integer
    "P500 47c. Interest, dividends, net rental income (USD):"
      p500Interest: integer
    "P500 47d. Social Security or Railroad Retirement (USD):"
      p500SocialSecurity: integer
    "P500 47e. Supplemental Security Income (USD):"
      p500Ssi: integer
    "P500 47f. Public assistance or welfare (USD):"
      p500Welfare: integer
    "P500 47g. Retirement, survivor or disability pensions (USD):"
      p500Pension: integer
    "P500 47h. Any other regular income (USD):"
      p500OtherIncome: integer
  }
  "P500 48. Total income in the past 12 months (USD):"
    p500Income: integer = p500Wages + p500SelfEmpIncome + p500Interest + p500SocialSecurity + p500Ssi + p500Welfare + p500Pension + p500OtherIncome
  "P500 Receives public assistance:"
    p500OnAssistance: boolean = p500Ssi > 0 || p500Welfare > 0
  "P500 Household income so far (USD):"
    p500HhIncome: integer = p499HhIncome + p500Income
  "P500 Workers in the household so far:"
    p500HhWorkers: integer = p499HhWorkers + (p500Hours + 98) / 99

  // ---------------------------------------------------------------- Household summary
  "Household income (USD):"
    hhIncome: integer = p500HhIncome
  "Workers in household:"
    hhWorkers: integer = p500HhWorkers
  "Housing cost burden (percent of income):"
    hhBurden: integer = hMonthlyCost * 12 * 100 / (hhIncome + 1)
  "Cost-burdened household (more than 30 percent):"
    hhCostBurdened: boolean = hhBurden > 30
  "Severely cost-burdened household (more than 50 percent):"
    hhSeverelyBurdened: boolean = hhBurden > 50
  "2023 poverty guideline for this household size (USD):"
    hhPovertyLine: integer = 14580 + (nPersons - 1) * 5140
  "Household below the poverty guideline:"
    hhPoor: boolean = hhIncome < hhPovertyLine
  "No worker in the household:"
    hhNoWorker: boolean = hhWorkers == 0
}

  // ---------------------------------------------------------------- Household summary
  "Household income (USD):"
    hhIncome: integer = p5HhIncome
  "Workers in household:"
    hhWorkers: integer = p5HhWorkers
  "Housing cost burden (percent of income):"
    hhBurden: integer = hMonthlyCost * 12 * 100 / (hhIncome + 1)
  "Cost-burdened household (more than 30 percent):"
    hhCostBurdened: boolean = hhBurden > 30
  "Severely cost-burdened household (more than 50 percent):"
    hhSeverelyBurdened: boolean = hhBurden > 50
  "2023 poverty guideline for this household size (USD):"
    hhPovertyLine: integer = 14580 + (nPersons - 1) * 5140
  "Household below the poverty guideline:"
    hhPoor: boolean = hhIncome < hhPovertyLine
  "No worker in the household:"
    hhNoWorker: boolean = hhWorkers == 0
}

  if (p100Age >= 5) {
    "P100 12. Speaks a language other than English at home?"
      p100OtherLanguage: boolean
    if (p100OtherLanguage) {
      "P100 12. Which language?"
        p100Language: string
      "P100 12. Speaks English very well?"
        p100EnglishWell: boolean
    }
  }
  "P100 15. Lived in this house one year ago?"
    p100SameHouse: boolean
  "P100 16. Covered by health insurance through an employer?"
    p100InsEmployer: boolean
  "P100 16. Covered by Medicare?"
    p100InsMedicare: boolean
  "P100 16. Covered by Medicaid or other government assistance plan?"
    p100InsMedicaid: boolean
  "P100 Uninsured:"
    p100Uninsured: boolean = !p100InsEmployer && !p100InsMedicare && !p100InsMedicaid
  "P100 17. Difficulty concentrating, remembering or making decisions?"
    p100DifficultyCognitive: boolean
  "P100 18. Difficulty walking or climbing stairs?"
    p100DifficultyWalking: boolean
  if (p100Age >= 15) {
    "P100 20. Currently married?"
      p100Married: boolean
    "P100 21. Highest degree or level of school completed:"
      p100Education: string
  }
  if (p100Age >= 16) {
    "P100 30. Worked for pay last week?"
      p100WorkedLastWeek: boolean
    if (p100WorkedLastWeek) {
      "P100 31. Address of main place of work:"
        p100WorkAddress: string
      "P100 33. Minutes to get from home to work:"
        p100CommuteMinutes: integer
      "P100 33. Long commute (60 minutes or more):"
        p100LongCommute: boolean = p100CommuteMinutes >= 60
      "P100 41. Usual hours worked per week:"
        p100Hours: integer
      "P100 41. Works full time:"
        p100FullTime: boolean = p100Hours >= 35
      "P100 44. Self-employed in own business?"
        p100SelfEmployed: boolean
      "P100 46. Kind of work (occupation):"
        p100Occupation: string
    } else {
      "P100 36. Looking for work in the last 4 weeks?"
        p100LookingForWork: boolean
    }
  }
  if (p100Age >= 15) {
    "P100 47a. Wages, salary, commissions, bonuses or tips (USD):"
      p100Wages: integer
    "P100 47b. Self-employment income (USD):"
      p100SelfEmpIncome: integer
    "P100 47c. Interest, dividends, net rental income (USD):"
      p100Interest: integer
    "P100 47d. Social Security or Railroad Retirement (USD):"
      p100SocialSecurity: integer
    "P100 47e. Supplemental Security Income (USD):"
      p100Ssi: integer
    "P100 47f. Public assistance or welfare (USD):"
      p100Welfare: integer
    "P100 47g. Retirement, survivor or disability pensions (USD):"
      p100Pension: integer
    "P100 47h. Any other regular income (USD):"
      p100OtherIncome: integer
  }
  "P100 48. Total income in the past 12 months (USD):"
    p100Income: integer = p100Wages + p100SelfEmpIncome + p100Interest + p100SocialSecurity + p100Ssi + p100Welfare + p100Pension + p100OtherIncome
  "P100 Receives public assistance:"
    p100OnAssistance: boolean = p100Ssi > 0 || p100Welfare > 0
  "P100 Household income so far (USD):"
    p100HhIncome: integer = p99HhIncome + p100Income
  "P100 Workers in the household so far:"
    p100HhWorkers: integer = p99HhWorkers + (p100Hours + 98) / 99

  // ---------------------------------------------------------------- Household summary
  "Household income (USD):"
    hhIncome: integer = p100HhIncome
  "Workers in household:"
    hhWorkers: integer = p100HhWorkers
  "Housing cost burden (percent of income):"
    hhBurden: integer = hMonthlyCost * 12 * 100 / (hhIncome + 1)
  "Cost-burdened household (more than 30 percent):"
    hhCostBurdened: boolean = hhBurden > 30
  "Severely cost-burdened household (more than 50 percent):"
    hhSeverelyBurdened: boolean = hhBurden > 50
  "2023 poverty guideline for this household size (USD):"
    hhPovertyLine: integer = 14580 + (nPersons - 1) * 5140
  "Household below the poverty guideline:"
    hhPoor: boolean = hhIncome < hhPovertyLine
  "No worker in the household:"
    hhNoWorker: boolean = hhWorkers == 0
}

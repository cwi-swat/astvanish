
export { run as run };

function run($prog, args) {
    var env = {};
    with (_ _ : $prog) {
        for (const d of $1) 
            with (def _ ( _ ) = _ ; : d) 
                env[$1.toString()] = function(args) {
                    var myEnv = Object.assign({}, env);
                    for (const f of $2) {
                        myEnv[f.toString()] = args.shift();
                    }
                    return eve($3, myEnv);
                };
        return env[$2.toString()](args.slice());
    }
}

function eve($exp, env) {
    match ($exp) {
        case _@Id : return env[$1.toString()];
        case _@Num : return parseInt($1.toString());
        case _ * _ : return eve($1, env) * eve($2, env);
        case _ - _ : return eve($1, env) - eve($2, env);
        case _ > _ : return eve($1, env) > eve($2, env);
        case if _ then _ else _ fi :
            return eve($1, env) ? eve($2, env) : eve($3, env);
        case _ ( _ ) : 
            var args = [];
            for (const a of $2) 
                args.push(eve(a, env));
            return env[$1.toString()](args);
    }
}

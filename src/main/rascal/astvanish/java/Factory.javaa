package astvanish;


import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Paths;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

import com.google.gson.Gson;

public abstract class Factory {

    @SuppressWarnings({ "unchecked", "rawtypes" })
    public static void main(String[] args) throws IOException {
        String src = readMyJson();
        Gson gson = new Gson();
        Map ast = gson.fromJson(src, Map.class);

        Factory f = factory(ast);

        System.out.println(f.schemaName());

        IObject aPerson = f.create("Person");
        aPerson.set("name", "Jurgen");
        System.out.println(aPerson.get("name"));
        System.out.println(aPerson.get("age"));
        aPerson.set("age", 40);
        System.out.println(aPerson.get("age"));
    }


     public static String readMyJson() throws IOException {
        return new String(Files.readAllBytes(Paths.get("src/main/rascal/astvanish/demo/persons.json")));
    }


    public abstract String schemaName();
    public abstract IObject create(String className);

    public interface IObject {
        void set(String field, Object value);
        Object get(String field);
    }

    public interface IClass {
        IObject make();
    }

    private static void initialize(Map<String,Object> data, String fld, $ type) {
        System.out.println(type);
        match (type) {
            case int:
                data.put(fld, 0); 
                break;
            case bool:
                data.put(fld, false);
                break;
            case str:
                data.put(fld, "");
                break;
        }
    }

    private static void checkType(Object value, $ type) {
        match (type) {
            case int :
                if (!(value instanceof Integer)) {
                    throw new RuntimeException("type error");
                }
                break;
            case bool :
                if (!(value instanceof Boolean)) {
                    throw new RuntimeException("type error");
                }
                break;
            case str:
                if (!(value instanceof String)) {
                    throw new RuntimeException("type error");
                }
                break;
        }
    }

    @SuppressWarnings("unchecked")
    public static Factory factory($ schema) {
        return new Factory() {
            public String schemaName() {
                with (schema _ _ : schema) {
                    return $1.toString();
                }
            }

            private Map<String, IClass> classes = new HashMap<String,IClass>();

            public IObject create(String className) {
                if (!classes.containsKey(className)) {
                    throw new RuntimeException("no such class");
                }
                return classes.get(className).make();
            }

            { 
                with (schema _ _ : schema) {
                    for ($ c: $2) {
                        with (class _ { _ }: c) {
                            classes.put($1.toString(), new IClass() {
                                public IObject make() {
                                    return new IObject() {

                                        private Map<String,Object> data = new HashMap<String,Object>();

                                        {
                                            for ($ f: $2) {
                                                with (_ \: _ : f) {
                                                    initialize(data, $1.toString(), $2);
                                                }
                                            }
                                        }

                                        public void set(String field, Object value) {
                                            if (!data.containsKey(field)) {
                                                throw new RuntimeException("no such field " + field);
                                            }
                                            for ($ f: $2) {
                                                with (_ \: _ : f) {
                                                    if ($1.toString().equals(field)) {
                                                        checkType(value, $2);
                                                    }
                                                }
                                            }
                                            data.put(field, value);
                                        }

                                        public Object get(String field) {
                                            if (!data.containsKey(field)) {
                                                throw new RuntimeException("no such field " + field);
                                            }
                                            return data.get(field);
                                        }

                                    };
                                }
                            });
                        }
                    }   
                }
                
            }
        };
    }
}


package astvanish;

import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.function.Function;


public class Func {
    
    @SuppressWarnings("unchecked")
    public static Object run($ prog, List<Object> args) {
        Map<String,Object> env = new HashMap<String,Object>();
        with (_ _ : prog) {
            for ($ d : $1) {
                with (def _ ( _ ) _ ; : d) {
                    env.put($1.toString(), new Function<List<Object>, Object>() {
                        public Object apply(List<Object> args) {
                            Map<String,Object> myEnv = new HashMap<String,Object>(env);
                            List<Object> argsList = new ArrayList<Object>(args);
                            for ($ f: $2) {
                                myEnv.put(f.toString(), argsList.remove(0));
                            }
                            return eve($1, myEnv);
                        }
                    });
                }
            }
            return ((Function<List<Object>, Object>)env.get($2.toString())).apply(args);
        }
    }

    @SuppressWarnings("unchecked")
    public static Object eve($ exp, Map<String,Object> env) {
        match (exp) {
            case _@Id : 
                return env.get($1.toString());

            case _@Num : 
                return Integer.parseInt($1.toString());
            
            case _ * _ : { 
                int lhs = (int) eve($1, env);
                int rhs = (int) eve($2, env);
                return lhs * rhs;
            }
            
            case _ - _: { 
                int lhs = (int) eve($1, env);
                int rhs = (int) eve($2, env);
                return lhs - rhs;
            }
            
            case _ > _: { 
                int lhs = (int) eve($1, env);
                int rhs = (int) eve($2, env);
                return lhs > rhs;
            }
            
            case if _ then _ else _ fi : {
                boolean cond = (boolean) eve($1, env);
                if (cond) {
                    return eve($2, env);
                }
                return eve($3, env);
            }
            
            case _ ( _ ): {
                List<Object> args = new ArrayList<Object>();
                for ($ a: $2) {
                    args.add(eve(a, env));
                }
                return ((Function<List<Object>, Object>)env.get($1.toString())).apply(args);
            }

        }

        return null;
    }
 
}

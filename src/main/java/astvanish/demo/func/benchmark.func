//@@ src/main/java/astvanish/demo/func/Func.javaa: run(prog)

// A benchmark workload for Func, scaled by a single argument n (try 10..25).
// It mixes call-heavy recursion (fib, tak) with arithmetic- and branch-heavy
// code (collatz, primes). Ranges are split divide-and-conquer style to keep
// the recursion depth logarithmic, and all values stay well within 32 bits,
// so the JS (doubles) and Java (int) interpreters compute identical results.

def fib(n) = if n < 2 then n else fib(n - 1) + fib(n - 2) fi;

def tak(x, y, z) =
  if !(y < x) then z
  else tak(tak(x - 1, y, z), tak(y - 1, z, x), tak(z - 1, x, y)) fi;

def collatz(n, steps) =
  if n == 1 then steps
  else if n % 2 == 0 then collatz(n / 2, steps + 1)
  else collatz(3 * n + 1, steps + 1) fi fi;

def noDivisor(n, d) = d * d > n || n % d != 0 && noDivisor(n, d + 1);

def isPrime(n) = n >= 2 && noDivisor(n, 2);

def sumCollatz(lo, hi) =
  if lo >= hi then collatz(lo, 0)
  else let mid = (lo + hi) / 2 in sumCollatz(lo, mid) + sumCollatz(mid + 1, hi) end fi;

def countPrimes(lo, hi) =
  if lo >= hi then (if isPrime(lo) == true then 1 else 0 fi)
  else let mid = (lo + hi) / 2 in countPrimes(lo, mid) + countPrimes(mid + 1, hi) end fi;

def abs(x) = if x <= 0 then -x else x fi;

def bench(n) =
  let calls = fib(n) + tak(n / 2, n / 3, n / 6) in
  let arith = sumCollatz(1, n * 100) - countPrimes(1, n * 100) in
    abs(arith - calls) % 1000000
  end
  end;

bench

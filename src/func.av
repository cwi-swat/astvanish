
function run($prog) {
    var env = {};
    with (_ _ : $prog) {
        for (const d of $1) 
            with (def _ ( _ ) = _ ; : d) 
                env[$1.toString()] = function(args) {
                    var myEnv = Object.assign({}, env);
                    for (const f of $2) {
                        myEnv[f.toString()] = args.shift();
                    }
                    return eval($3, myEnv);
                };
        return eval($2, env);
    }
}

function eval($exp, env) {
    var result;

    match ($exp) {
        case _@Id : result = env[$1.toString()];
        case _@Num : result = parseInt($1.toString());
        case _ * _ : result = eval($1, env) * eval($2, env);
        case _ - _ : result = eval($1, env) - eval($2, env);
        case _ > _ : result = eval($1, env) > eval($2, env);
        case if _ then _ else _ fi :
            result = eval($1, env) ? eval($2, env) : eval($3, env);
        case _ ( _ ) : 
            var args = [];
            for (const a of $2) 
                args.push(eval(a, env));
            result = env[$1.toString()](args);
    }

    return result;
}

function run($prog) {
    var env = {};
    with (_ _ : $prog) {
        for (const d of $1) 
            with (def _ ( _ ) = _ ; : d) 
                env[$1.toString()] = function(args) {
                    var myEnv = Object.assign({}, env);
                    for (const f of $2) {
                        myEnv[f.toString()] = args.shift();
                    }
                    return eval($3, myEnv);
                };
        return eval($2, env);
    }
}

function eval($exp, env) {
    match ($exp) {
        case _@Id : return env[$1.toString()];
        case _@Num : return parseInt($1.toString());
        case _ * _ : return eval($1, env) * eval($2, env);
        case _ - _ : return eval($1, env) - eval($2, env);
        case _ > _ : return eval($1, env) > eval($2, env);
        case if _ then _ else _ fi :
            return eval($1, env) ? eval($2, env) : eval($3, env);
        case _ ( _ ) : 
            var args = [];
            for (const a of $2) 
                args.push(eval(a, env));
            return env[$1.toString()](args);
    }
}

function format($prog) {
    var src = '';
    with (_ _ : $prog) {
        for (const d of $1) 
            with (def _ ( _ ) = _ ; : d) {
                src += 'def ' + $1.toString() + "(";
                for (const p of $2) {
                    src += p.toString() + ',';
                }
                src += ')\n';
                src += formatExp($3);
                src += ';\n';
            }
        src += '\n' + formatExp($2);
    }
    return src;
}


function formatExp($exp) {
    return $exp.toString(); // for now
}

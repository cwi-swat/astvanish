


function run($p) {
    match ($p) {
        case while _ do _ od: 
            runWhileDummy($p, 1);
    }

}

// count is the reason we need to reject the recursion here
// because the input to count is constant in run, peval will propagate
// it (and compute the addition in runWhile), hence peval
// won't terminate since we memoize on static args including
// such constants,--count will be different every iteration. 
// Without constant propagation the memoization
// would indeed terminate peval, but at the cost of infinite
// recursion at run time, which is also undesirable. 

function runWhileDummy($p, count) {
    runWhile($p, count);
}

function dummy($wh, count) {
    dummy2($wh, count);
}

function dummy2($wh, count) {
    runWhile($wh, count);
}


function runWhile($wh, count) {
    function () {
        with (while _ do _ od: $wh) {
            if (eval($1)) {
                run($2);
                dummy($wh, count + 1);
            }
        }
    };
}



function step($m, state, event) {
    match ($m) {
        case machine _ _ end: 
            for ($s in $2) {
                match ($s) {
                    case state _ _ end: 
                        if ($s.toString() === state.current) {
                            for ($t in $2) {
                                match ($t) {
                                    case _ => _: 
                                        if ($1.toString() === event) {
                                            state.current = $s.toString();
                                        }
                                        return;
                                }
                            }
                        }
                }
            }
    }
}

var scope = {};
function main($prog) {
    var env = {};
    match ($prog) {
        case _ _ : {
            for ($d in $1) {
                decl($d, env);
            }
            return exec($2, env);
        }
    }
}

function decl($decl, env) {
    match ($decl) {
        case def _ ( _ ) _ end: 
            scope[$1.toString()] = function(args) { // could be varargs/spread
                env = Object.assign({}, env);
                for ($f in $2) {
                    env[$f.toString()] = args.shift();
                }
                return exec($3, env);
            };
    }
}

//@Step("Statement")
function exec($stmt, env) {
    match ($stmt) {
        case _ ( _ ) ; : 
            var args = [];
            for ($a in $2) {
                args.unshift(eval($a, env));
            }
            scope[$1.toString()](args);

        case { _ } :
            for ($s in $1) {
                exec($s, env);
            }
        
        case if ( _ ) _ else _ :
            var x = eval($1, env);
            if (x) {
                exec($2, env);
            }
            else {
                exec($3, env);
            }

        case while ( _ ) _ : 
            while (eval($1, env)) {
                exec($2, env);
            }
    }
}

function eval($exp, env) {
    console.log($exp.toString());
    match ($exp) {
        case _@Int : // todo? inline annotations? or let JS deal with it? 
            return parseInt($1.toString());
            // becomes: function eval$...(env) { return parseInt("42"); }
        
        case _@Id : 
            return env[$1.toString()];
            // becomes: function eval$...(env) { return env["x"]; }
        
        case _ + _ : 
            return eval($1, env) + eval($2, env);
            // becomes: function eval$...(env) { return eval$...(env) + eval$...(env); }
        
        case let _ = _ in _ : 
            env = Object.assign({}, env);
            env[$1.toString()] = eval($2, env);
            return eval($3, env);
            /* becomes:

            function eval$...(env) {
                env = Object.assign({}, env);
                env["x"] = eval$...(env);
                return eval$...(env);
            }

            */


        case _ => _:
            return function (x) {
                env = Object.assign({}, env);
                env[$1.toString()] = x;
                return eval($2, env);
            };
            /* becomes:

            function eval$...(env) {
                return function (x) {
                    env = Object.assign({}, env);
                    env["x"] = x;
                    return eval$...(env);
                };
            }
            */

        case _ ( _ ): 
            return $eval($1)($eval($2));
            /* becomes:

            function eval$...(env) {
                return eval$...(env)(eval$...(env));
            }

            */
    }
}
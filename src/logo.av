


function* run($logo, state) {
    with (_ : $log) {
        for (const s of $1) {
            exec(s, state);
        }
    }
}

function* exec($stmt, state) {
    yield {state: state, src: $stm.src};
    match ($stmt) {
        case forward _: 
            canvas.lineTo(eval($1, state));
            // plus updates to state
        
        case turn _: 
            state.angle = (state.angle + eval($1, state)) % 360;

        case repeat _ { _ }: {
            for (var i = 0; i < eval($1, state); i++) {
                for (const s of $2) {
                    exec(s, state);
                }
            }
        }
    }
}

function eval($exp) {
    return parseInt($exp.toString());
}

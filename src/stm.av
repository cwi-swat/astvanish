


function run($m, $acts, state, event) {
    with (machine _ end : $m) {
        for (const s of $1) {
            console.log(s.src);
            if (handleState(s, $acts, state, event)) {
                return;
            }
        }
    }
}


function handleState($s, $actions, state, event) {
    with (state _ _ end: $s) {
        if ($1.toString() === state.current) {
            return doTrans($1, $2, $actions, state, event);
        }
        return false;
    }
}

function doTrans($name, $ts, $actions, state, event) {
    for (const t of $ts) {
        with (_ => _ : t) {
            if ($1.toString() === event) {
                state.current = $2.toString();
                doActions($2, $actions);
                return true;
            }
        }
    }
    return false;
}

function doActions($name, $actions) {
    with (_ : $actions) {
        for (const a of $1) {
            with (on _ do { _ }: a) {
                // this for-loop plus if implements a kind of lookup
                // it matches up states and their action clauses
                // (related to "the trick" in peval folklore)
                if ($1.toString() == $name.toString()) {
                    for (const c of $2) {
                        match (c) {
                            case beep: console.log('beep');
                            case print: console.log('print');
                            case send: console.log('send');
                        }
                    }
                }
            }       
        }
    }
}